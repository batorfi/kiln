# Root .gitignore — Node/TypeScript stack for the kiln/ extension (T002 / plan "Setup").
# Universal + Node/TS patterns. The kiln/ runtime pulls NO network and NO deps, so
# there is no node_modules to ignore today; these guard a later row that adds one.

# --- Node / TypeScript ---
node_modules/
dist/
build/
coverage/
*.log
*.tsbuildinfo
.env*

# --- Editor / OS / VCS tooling ---
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/

# --- runtime artifacts (factory-log runs write these locally) ---
# legacy/ is the first program's tree, moved from kiln/ (r12); its dogfood scripts write here.
legacy/factory-log/*.jsonl
legacy/factory-log/*.log
!legacy/factory-log/.gitkeep
# kiln/ is the new codebase; the same rule for any factory-log it writes later.
kiln/factory-log/*.jsonl
kiln/factory-log/*.log
!kiln/factory-log/.gitkeep

# Spec Kit catalog cache (written by `specify integration list/info/search`) — machine-local
.specify/integrations/.cache/

# r42 spike (outside kiln/): installed dependencies and generated evidence are not committed
spikes/r42/node_modules/
spikes/r42/out/
