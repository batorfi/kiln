{
  "name": "kiln",
  "version": "0.1.0",
  "description": "KILN — a local, single-lane, spec-driven development factory for Pi: one model at a time, a human at every gate, no cloud. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batorfi/kiln.git"
  },
  "author": "Zsolt Bátorfi",
  "type": "module",
  "pi": {
    "extensions": ["./pi/index.ts"]
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "test": "node tests/run.ts",
    "test:live": "node tests/run.ts --cost",
    "test:pi": "node tests/run.ts --pi \"tests/pi/*.test.ts\"",
    "live-inference": "node tests/run.ts --live --serial tests/live-inference",
    "switch-cost": "node tests/run.ts --cost tests/switch-cost",
    "validate:log": "node validate/log.ts",
    "validate:roadmap": "node validate/roadmap.ts",
    "firing-ready": "node validate/firing-ready.ts",
    "runtime-ready": "node validate/runtime-ready.ts",
    "overlay-ready": "node validate/overlay-ready.ts",
    "live-ready": "node validate/live-ready.ts",
    "ollama-ready": "node validate/ollama-ready.ts",
    "pi-ready": "node validate/pi-ready.ts",
    "dogfood": "node tests/dogfood/run.ts",
    "program-walk": "node tests/dogfood/run-program.ts",
    "live-walk": "node tests/dogfood/run-live.ts",
    "capture-fixture": "node tests/dogfood/capture-fixture.ts"
  },
  "dependencies": {}
}
