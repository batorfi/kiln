{
  "name": "kiln",
  "version": "0.2.0",
  "private": true,
  "description": "KILN — a local software factory you own: agents work, independent judges check, people decide at every gate. The restart codebase (r12 onward); the first program lives in ../legacy. Three pinned dependencies (the durable runtime and its two companions, recorded in DEPENDENCIES.md); one install step: npm ci.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batorfi/kiln.git"
  },
  "author": "Zsolt Bátorfi",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.1.0"
  },
  "imports": {
    "#contracts/*": "./packages/contracts/src/*",
    "#record/*": "./packages/record/src/*",
    "#lane/*": "./packages/lane/src/*",
    "#durable/*": "./packages/durable/src/*",
    "#workers/*": "./packages/workers/src/*",
    "#director/*": "./packages/director/src/*",
    "#server/*": "./packages/server/src/*",
    "#cli/*": "./packages/cli/src/*",
    "#checks/*": "./checks/*"
  },
  "scripts": {
    "test": "node tests/run.ts",
    "test:new": "node tests/run.ts --new-only",
    "test:legacy": "node tests/run.ts --legacy-only",
    "proof": "node tests/run.ts --new-only --proof",
    "kiln": "node packages/cli/src/main.ts",
    "check": "node packages/cli/src/main.ts check",
    "validate:log": "node packages/record/src/log.ts",
    "validate:roadmap": "node packages/record/src/roadmap.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  }
}
