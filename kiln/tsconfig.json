{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
     "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
   },
  "include": ["**/*.ts"]
}
